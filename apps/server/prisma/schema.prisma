// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Supabase Transaction mode (pgBouncer)
  directUrl = env("DIRECT_URL")     // prisma migrate dev 용 direct 연결
}

/// Hipparcos 별 카탈로그 (초기 1회 적재, 이후 읽기 전용)
model Star {
  /// Hipparcos 카탈로그 고유번호 — 자연키를 PK로 사용
  hipId     Int     @id @map("hip_id")

  /// 적경 Right Ascension (도, 0 ~ 360)
  ra        Float

  /// 적위 Declination (도, -90 ~ 90)
  dec       Float

  /// 겉보기 등급 (낮을수록 밝음)
  magnitude Float

  /// 고유 명칭 (없으면 null)
  name      String? @map("proper_name")

  @@index([magnitude])
  @@map("stars")
}

/// 서비스 이용자
model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String          @map("password_hash")
  createdAt      DateTime        @default(now()) @map("created_at")
  constellations Constellation[]

  @@map("users")
}

/// 사용자가 저장한 별자리
model Constellation {
  id         Int                 @id @default(autoincrement())
  userId     Int                 @map("user_id")
  name       String
  memo       String?
  lat        Float
  lng        Float
  observedAt DateTime            @map("observed_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars      ConstellationStar[]

  @@index([userId])
  @@map("constellations")
}

/// 별자리를 구성하는 별 (순서 포함)
model ConstellationStar {
  id              Int           @id @default(autoincrement())
  constellationId Int           @map("constellation_id")
  hipId           Int           @map("hip_id")
  order           Int
  constellation   Constellation @relation(fields: [constellationId], references: [id], onDelete: Cascade)

  @@index([constellationId])
  @@map("constellation_stars")
}
